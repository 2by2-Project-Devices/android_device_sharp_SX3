# Esim
masterclear.allow_retain_esim_profiles_after_fdr=true
persist.radio.sar.cmd=1

# Bluetooth
bluetooth.device_id.vendor_id=0x0046
bluetooth.device.class_of_device=90,2,12

# Camera
persist.vendor.camera.privapp.list=org.lineageos.aperture
vendor.camera.aux.packagelist=org.lineageos.aperture

# Skia tracing
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false
